{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example-org.uk/local-plan/0.1/common/codelists.schema.json",
  "title": "Codelists",
  "description": "Codelists maintained by MHCLG on planning.data.gov.uk, used as allowed values in record schemas.",
  "$defs": {
    "development-plan-document-type": {
      "description": "A development plan document type from https://www.planning.data.gov.uk/dataset/development-plan-document-type",
      "$comment": "Checked against planning.data.gov.uk on 2026-10-16. Includes both sustainability-apprasial and sustainability-appraisal, as the published codelist does.",
      "type": "string",
      "enum": [
        "local-plan",
        "adoption-statement",
        "area-action-plan",
        "financial-viability-study",
        "inspectors-report",
        "policies-map",
        "strategic-flood-risk-assessment",
        "strategic-housing-market-assessment",
        "supplementary-planning-documents",
        "local-development-scheme",
        "sustainability-apprasial",
        "local-plan-review",
        "core-strategy",
        "site-allocations",
        "viability-assessment",
        "sustainability-appraisal"
      ]
    },
    "plan-event": {
      "description": "A plan event from https://www.planning.data.gov.uk/dataset/plan-event",
      "$comment": "Checked against planning.data.gov.uk on 2026-10-16.",
      "type": "string",
      "enum": [
        "plan-adopted",
        "inspector-report-published",
        "submit-plan-for-examination",
        "planning-inspectorate-examination-start",
        "planning-inspectorate-examination-end",
        "planning-inspectorate-found-sound",
        "timetable-published",
        "estimated-submit-plan-for-examination",
        "reg-18-draft-local-plan-published",
        "reg-18-public-consultation-start",
        "reg-18-public-consultation-end",
        "reg-19-publication-local-plan-published",
        "reg-19-public-consultation-start",
        "reg-19-public-consultation-end",
        "estimated-reg-18-draft-local-plan-published",
        "estimated-reg-18-public-consultation-end",
        "estimated-reg-19-public-consultation-start",
        "estimated-reg-19-public-consultation-end",
        "estimated-reg-18-public-consultation-start",
        "estimated-reg-19-publication-local-plan-published",
        "estimated-plan-adoption-date",
        "plan-withdrawn",
        "publish-notice-intention-commence",
        "scoping-consultation-start",
        "scoping-consultation-end",
        "gateway-1-self-assessment",
        "plan-content-evidence-consultation-start",
        "plan-content-evidence-consultation-end",
        "gateway-2-advice-sought",
        "gateway-2-advice-published",
        "proposed-plan-consultation-start",
        "proposed-plan-consultation-end",
        "gateway-3-advice-sought",
        "gateway-3-advice-published",
        "gateway-3-further-advice-sought",
        "gateway-3-repeat-advice-published",
        "examination-submitted",
        "examination-recommendations-published",
        "main-modification-consultation-start",
        "main-modification-consultation-end",
        "examination-pause-start",
        "examination-pause-end",
        "adopted",
        "additional-consultation-start",
        "additional-consultation-end",
        "withdrawn",
        "revoked"
      ]
    },
    "actor": {
      "description": "A party a policy places a duty or permission on.",
      "$comment": "Placeholder: values to be agreed through co-design.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "examples": ["applicant", "developer", "local-planning-authority"]
    },
    "metric": {
      "description": "A measurable quantity a policy constraint applies to.",
      "$comment": "Placeholder: values to be agreed through co-design. Each value should imply its unit.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "examples": [
        "affordable-housing-percentage",
        "building-height-storeys",
        "dwelling-count"
      ]
    },
    "evidence-document-type": {
      "description": "A type of document an applicant may be asked to submit as evidence.",
      "$comment": "Placeholder: values to be agreed through co-design. Distinct from development-plan-document-type.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "examples": [
        "flood-risk-assessment",
        "transport-assessment",
        "heritage-statement"
      ]
    }
  }
}
