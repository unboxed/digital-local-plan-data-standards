{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example-org.uk/local-plan/0.1/layer.schema.json",
  "title": "Layer",
  "description": "A spatial layer associated with a local plan policy, as a GeoJSON FeatureCollection.",
  "type": "object",
  "required": ["type", "reference", "name", "features"],
  "properties": {
    "type": {
      "const": "FeatureCollection"
    },
    "reference": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "geometry", "properties"],
        "properties": {
          "type": {
            "const": "Feature"
          },
          "geometry": {
            "$ref": "common/geometry.schema.json"
          },
          "properties": {
            "type": "object"
          }
        }
      }
    }
  }
}
